<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ AJOUTÉ (6 nov 2026, demande Paul) — Écran simplifié chauffeur, version PAYSAGE (layout-land).
     Surcouche en lecture sur l'onglet existant : aucune donnée n'est dupliquée, les boutons
     délèguent aux boutons existants (voir SimplifiedDriverOverlay).
     La version portrait est dans layout/overlay_simplified.xml (mêmes ids). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F8"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- En-tête : logo + registre + Support + Admin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#024B3C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Filgo Énergie"
            android:src="@mipmap/logoenergie1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sTxtRegistre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Registre"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sTxtRegistreEtat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Connexion en cours…"
                android:textColor="#CFE8DF"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sBtnSupport"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:contentDescription="Demander du support"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="Support"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:icon="@drawable/ic_attach"
            app:iconTint="#FFFFFF"
            app:strokeColor="#80FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sBtnAdmin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Accès Admin"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="Admin"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:icon="@drawable/ic_lock"
            app:iconTint="#FFFFFF"
            app:strokeColor="#80FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Bandeau d'état -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#E8F0F9"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#185FA5"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="96dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <View
                        android:id="@+id/sDot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="#185FA5" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sTxtTitre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Connexion au registre…"
                            android:textColor="#0E3F70"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sTxtSous"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textColor="#0E3F70"
                            android:textSize="15sp" />

                        <ProgressBar
                            android:id="@+id/sProgConn"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:indeterminate="true"
                            android:indeterminateTint="#185FA5"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <!-- Live : Net / Gross / Déjà livré -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.55"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#D5DBD9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET"
                        android:textColor="#3A3A3A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sTxtNet"
                            android:layout_width="0dp"
                            android:layout_height="150dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:text="0,0"
                            android:textColor="#8A9591"
                            android:textSize="90sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="150sp"
                            app:autoSizeMinTextSize="40sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="18dp"
                            android:text="L"
                            android:textColor="#3A3A3A"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#F7F8F8"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GROSS"
                                android:textColor="#3A3A3A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/sTxtGross"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0,0 L"
                                android:textColor="#111111"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#F7F8F8"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DÉJÀ LIVRÉ (CE WO)"
                                android:textColor="#3A3A3A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/sTxtDejaLivre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#111111"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Livraison -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#D5DBD9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bon de travail"
                                android:textColor="#3A3A3A"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/sTxtWo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#111111"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Preset"
                                android:textColor="#3A3A3A"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/sTxtPreset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#111111"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sBlocProdFs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Produit à livrer (FieldService)"
                            android:textColor="#3A3A3A"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/sTxtProdFs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#024B3C"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Produit du registre"
                        android:textColor="#3A3A3A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/sTxtProdReg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sTxtTicket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ticket Number : —"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/sTxtVente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sale Number : —"
                        android:textColor="#111111"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barre du bas : WO complété + actions -->
    <LinearLayout
        android:id="@+id/sBarreActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F8F8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

            <!-- WO complété (cliquable : détail des livraisons déjà faites) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sPanelWo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#D5DBD9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WO complété"
                            android:textColor="#3A3A3A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sTxtWoCumul"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#111111"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voir le détail"
                        android:textColor="#185FA5"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sBtnAnnuler"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:text="Annuler la livraison"
            android:textColor="#B3261E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="#B3261E"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sBtnTerminer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="72dp"
            android:text="Terminer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#024B3C"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sBtnLancer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="72dp"
            android:text="Lancer la livraison"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#15803D"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sBtnRetour"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="72dp"
            android:text="Retour au Bon de travail"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#185FA5"
            app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
