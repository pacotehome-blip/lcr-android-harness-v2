<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/regRootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/regRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================== HEADER / IDENTITÉ (Card) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtRegHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registre"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <!-- Ligne Node/From -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/txtLcrNode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LCR Node : —"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFrom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="From : —" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSerialId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="#Série : —"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtTicketNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ticket Number : —"
                    android:layout_marginTop="2dp" />

                <!-- Ticket pending en évidence -->
                <TextView
                    android:id="@+id/txtTicketPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ticket pending : —"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:padding="8dp"
                    android:background="#0F000000" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== PRODUIT / PRESET (Card) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Produit and Preset"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanProducts"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍 Scan produits"
                        android:textSize="11sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <!-- Produit -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Produit"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <AutoCompleteTextView
                            android:id="@+id/spnProduct"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:inputType="none"
                            android:focusable="false"
                            android:hint="Produit (1-16)"
                            android:textSize="12sp"
                            android:completionThreshold="1" />
                        <!-- ✅ CORRIGÉ (20 août 2026, demande Paul — "si on
                             clique dedans on ne doit plus être capable
                             d'éditer") — inputType="number" permettait de
                             taper du texte libre, indépendamment du menu
                             déroulant. inputType="none" + focusable="false"
                             force la sélection UNIQUEMENT via le menu
                             déroulant — plus de saisie manuelle possible. -->
                    </LinearLayout>

                    <!-- Preset -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Preset"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtPreset"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Preset"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== ACTIONS (Card) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Actions"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectTab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect LCP (ce registre)"
                    android:layout_marginTop="8dp" />

                <!-- A/B/C -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Resolve (A)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnB"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Status (B)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnC"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="New (C)" />
                </LinearLayout>

                <!-- Continue / Finish -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContinue"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Continuer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFinish"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Terminer" />
                </LinearLayout>

                <!-- ✅ Retour au Bon de travail — visible après livraison terminée -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetourWO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="✅ Retour au Bon de travail"
                    android:visibility="gone"
                    android:backgroundTint="#1976D2"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== ANNULER LIVRAISON ===================== -->
        <Button
            android:id="@+id/btnAnnuler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:text="⛔ Annuler la livraison"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC2222"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- ===================== LIVE + NET/GROSS (Card) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/txtLive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIVE: (en attente)"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/liveQtyPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:background="#0F000000">

                    <!-- Gauche : valeurs courantes de la livraison -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/txtQtyNet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NET: 0.0"
                            android:textStyle="bold"
                            android:textSize="24sp"
                            android:textColor="#000000" />

                        <TextView
                            android:id="@+id/txtQtyGross"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GROSS: 0.0"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#222222"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Droite : cumul WO — visible si WO déjà complété -->
                    <LinearLayout
                        android:id="@+id/panelWoCumul"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="#1A185FA5"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="WO complété"
                            android:textSize="11sp"
                            android:textColor="#185FA5"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtWoCumulNet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total NET: —"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#185FA5"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/txtWoCumulGross"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Total GROSS: —"
                            android:textSize="13sp"
                            android:textColor="#185FA5"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/txtWoCumulCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== TICKET / UID (Card) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ticket"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDeliveryUid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delivery UID : —"
                    android:layout_marginTop="6dp" />

                <!-- ✅ NOUVEAU: Reprint last ticket -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReprintTicket"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reprint (last ticket)"
                    android:layout_marginTop="8dp" />

                <!-- ✅ NOUVEAU: Impression custom ligne par ligne -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomPrint"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🖨️ Impression custom"
                    android:visibility="gone" />

                <!-- ✅ NOUVEAU (14 août 2026, demande Paul — "l'imprimante
                     est associée au registre", placé sous Reprint/Custom
                     Print) : test isolé, lecture seule, ne déclenche jamais
                     GET_MACHINE_STATUS ailleurs que sur demande explicite. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestPrinter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🖨️ Vérifier l'imprimante" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== LOGS (repliable, conservé) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <CheckBox
                    android:id="@+id/cbShowLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Afficher logs"
                    android:checked="false" />

                <LinearLayout
                    android:id="@+id/logPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <ScrollView
                        android:id="@+id/logScroll"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:fillViewport="true"
                        android:background="#111111">

                        <TextView
                            android:id="@+id/txtLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:typeface="monospace"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            android:textColor="#00FF00"
                            android:padding="10dp" />
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLog"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyLog"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Copy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScrollDown"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Down" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <CheckBox
                            android:id="@+id/cbTxRx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Afficher TX / RX"
                            android:checked="false" />

                        <CheckBox
                            android:id="@+id/cbLogTs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Timestamps UI + IO + API"
                            android:checked="false" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Spacer bas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
