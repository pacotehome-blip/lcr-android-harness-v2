
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- ===================== USB ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnScanUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan USB" />

        <Button
            android:id="@+id/btnPingUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ouvrir/Ping USB" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spnUsbDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- ===================== LCP (ÉTAT ÉDITABLE) ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/edtTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="TO (ex: 250)"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="FROM (ex: 255)"
            android:inputType="number"
            android:singleLine="true" />
    </LinearLayout>

    <!-- ===================== DIAGNOSTIC ===================== -->
    <TextView
        android:id="@+id/txtActiveNode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Node actif : —"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <!-- ===================== PRODUITS ===================== -->
    <Spinner
        android:id="@+id/spnProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <!-- ===================== PRODUIT / PRESET ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/edtProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Produit (#)"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtPreset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Preset"
            android:inputType="numberDecimal"
            android:singleLine="true" />
    </LinearLayout>

    <!-- ===================== CONNECT ===================== -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect (LCP)"
        android:layout_marginTop="6dp" />

    <!-- ===================== ACTIONS ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A" />

        <Button
            android:id="@+id/btnB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="B" />

        <Button
            android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="C" />
    </LinearLayout>

    <!-- ===================== CONTINUER / FIN ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Continuer" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Terminer" />
    </LinearLayout>

    <!-- ===================== LIVE ===================== -->
    <TextView
        android:id="@+id/txtLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LIVE: (en attente)"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <!-- ===================== LOG ===================== -->
    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"          <!-- ✅ FIX -->
        android:background="#111111">

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"      <!-- ✅ FIX -->
            android:textIsSelectable="true"   <!-- ✅ FIX -->
            android:textSize="12sp"
            android:textColor="#00FF00"
            android:padding="6dp" />
    </ScrollView>

    <!-- ===================== LOG ACTIONS ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear log" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Copy log" />
    </LinearLayout>

</LinearLayout>
