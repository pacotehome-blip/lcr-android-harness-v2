
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:orientation="vertical"
      android:padding="16dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TO (hex, ex: 0x01)" />

    <EditText
        android:id="@+id/edtTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:text="0x01" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FROM (hex, ex: 0xF0)" />

    <EditText
        android:id="@+id/edtFrom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:text="0xF0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product (1..16)" />

    <EditText
        android:id="@+id/edtProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preset L (0 = mode ouvert)" />

    <EditText
        android:id="@+id/edtPreset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:text="0" />

    <!-- Boutons Connexion / Diag / Start -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connexion USB (demander permission)" />

    <Button
        android:id="@+id/btnDiag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diagnostic RX (0,5 s)"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Delivery" />

    <!-- Bandeau Log I/O -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

      <CheckBox
          android:id="@+id/switchIoLog"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Activer log I/O (TX/RX)"/>

      <Button
          android:id="@+id/btnCopyLog"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Copier"
          android:layout_marginStart="16dp"/>

      <Button
          android:id="@+id/btnClearLog"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Effacer"
          android:layout_marginStart="8dp"/>
    </LinearLayout>
    
    <!-- === DIAGNOSTIQUE LCP : nouveaux boutons === -->
    <LinearLayout
        android:id="@+id/layoutDiagConsole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

    <Button
        android:id="@+id/btnScan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Scanner (0x28)" />

    <Button
         android:id="@+id/btnSendHex"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:text="Envoyer HEX" />
    </LinearLayout>


    <!-- Zone de log -->
    <TextView
        android:id="@+id/txtLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp" />

  </LinearLayout>
</ScrollView>
