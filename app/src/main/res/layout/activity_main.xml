
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Ligne paramètres LCP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="To (0xFA)" />

        <EditText
            android:id="@+id/edtFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="From (0xFF)" />
    </LinearLayout>

    <!-- Ligne produit / preset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Produit (1..16)" />

        <EditText
            android:id="@+id/edtPreset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Preset L (ex: 50.0)" />
    </LinearLayout>

    <!-- Ligne actions génériques -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Copier log" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Effacer log" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connexion USB" />
    </LinearLayout>

    <!-- Ligne A / B / C -->
    <LinearLayout
        android:id="@+id/lineABC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <!-- A reset / END -->
        <Button
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A reset (END)" />

        <!-- B ping -->
        <Button
            android:id="@+id/btnB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="B ping" />

        <!-- C – start delivery -->
        <Button
            android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="C – Start delivery" />
    </LinearLayout>

    <!-- Ligne "Continuer / Terminé" (prompt façon Python) -->
    <LinearLayout
        android:id="@+id/liveControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Continuer" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Terminé" />
    </LinearLayout>

    <!-- Switch I/O log -->
    <CheckBox
        android:id="@+id/switchIoLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I/O log" />

    <!-- Ancien "Start" (retiré) : on le laisse GONE pour compat -->
    <Button
        android:id="@+id/btnStart"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="(retiré)" />

    <!-- Zone de logs -->
    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="12sp"
            android:textColor="#000000"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:autoLink="none" />
    </ScrollView>

</LinearLayout>
