
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTabs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===================== HEADER (Filgo + Livraison) ===================== -->
    <LinearLayout
        android:id="@+id/headerFilgo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/imgFilgo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/logoenergie1"
            android:contentDescription="Filgo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txtHeaderLivraison"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Livraison"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- ===================== TABS (en haut) ===================== -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- ===================== PAGE 1: UI (MAIN) ===================== -->
    <LinearLayout
        android:id="@+id/pageMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- ===================== USB ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnScanUsb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan USB" />

                <Button
                    android:id="@+id/btnPingUsb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Ouvrir/Ping USB" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spnUsbDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- ===================== LCP (ÉTAT / MANUEL) ===================== -->
            <TextView
                android:id="@+id/txtActiveNode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LCP Node : "
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/edtTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="TO (ex: 250)"
                    android:inputType="number"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/edtFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="FROM (ex: 255)"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- ===================== AJOUT TAB (manuel) ===================== -->
            <Button
                android:id="@+id/btnAddRegisterTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter / Focus TAB (TO)"
                android:layout_marginTop="4dp" />

            <!-- ===================== SCAN REGISTRES (Option B) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnScanNodes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan registres (1..250)" />

                <Spinner
                    android:id="@+id/spnNodesFound"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtNodesSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nodes trouvés : —"
                android:layout_marginTop="2dp"
                android:textSize="12sp" />

            <!-- ===================== TABS REGISTRES (1 tab par lcrnode) ===================== -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabRegisters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:tabMode="scrollable"
                app:tabGravity="fill" />

            <FrameLayout
                android:id="@+id/registerContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp" />

            <!-- ===================== PRODUITS / PRESET (UI MAIN existante - conservée) ===================== -->
            <Spinner
                android:id="@+id/spnProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/edtProduct"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Produit (#)"
                    android:inputType="number"
                    android:singleLine="true" />

                <!-- ✅ FIX: cet id était dupliqué (txtActiveNode). On le remplace par txtPresetLabel. -->
                <TextView
                    android:id="@+id/txtPresetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset : "
                    android:textStyle="bold"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical" />

                <EditText
                    android:id="@+id/edtPreset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="Preset"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- ===================== CONNECT (UI MAIN existante - conservée) ===================== -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect (LCP)"
                android:layout_marginTop="4dp" />

            <!-- ===================== ACTIONS (UI MAIN existante - conservée) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Restore" />

                <Button
                    android:id="@+id/btnB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Status" />

                <Button
                    android:id="@+id/btnC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="New Delivery" />
            </LinearLayout>

            <!-- ===================== CONTINUER / FIN ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnContinue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Continuer" />

                <Button
                    android:id="@+id/btnFinish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Terminer" />
            </LinearLayout>

            <!-- ===================== LIVE ===================== -->
            <TextView
                android:id="@+id/txtLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE: (en attente)"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <!-- ===================== NET / GROSS ===================== -->
            <LinearLayout
                android:id="@+id/liveQtyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:padding="8dp"
                android:background="#F2F2F2">

                <TextView
                    android:id="@+id/txtQtyNet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NET: 0.0"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/txtQtyGross"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GROSS: 0.0"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#222222" />
            </LinearLayout>

            <!-- ===================== TICKET / PRINTER ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ticket / Impression"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTicketNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" />

                <TextView
                    android:id="@+id/txtDeliveryUid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" />
            </LinearLayout>

            <!-- ===================== LOG TOGGLE (global) ===================== -->
            <CheckBox
                android:id="@+id/cbShowLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Afficher log"
                android:checked="false"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <!-- ===================== LOG PANEL (global, hidden by default) ===================== -->
            <LinearLayout
                android:id="@+id/logPanel"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:background="#111111">

                    <TextView
                        android:id="@+id/txtLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:typeface="monospace"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        android:textColor="#00FF00"
                        android:padding="6dp" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnClearLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear log" />

                    <Button
                        android:id="@+id/btnCopyLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Copy log" />

                    <Button
                        android:id="@+id/btnScrollDown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Scroll down" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <CheckBox
                        android:id="@+id/cbTxRx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Afficher TX / RX"
                        android:checked="false"
                        android:minHeight="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"/>

                    <CheckBox
                        android:id="@+id/cbLogTs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Timestamps UI + IO + API"
                        android:checked="false"
                        android:minHeight="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ===================== PAGE 2: API-Face ===================== -->
        <LinearLayout
            android:id="@+id/pageApiFace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnDbBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backup DB (Downloads)"
                android:layout_margin="8dp" />

            <include layout="@layout/fragment_api_face" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
