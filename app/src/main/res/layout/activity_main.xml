<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===================== CONNECTION ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECT" />
        </LinearLayout>

        <!-- ===================== LIVE TECH (overwrite) ===================== -->
        <TextView
            android:id="@+id/txtLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textSize="12sp"
            android:textColor="#444444"
            android:padding="4dp"
            android:layout_marginBottom="6dp" />

        <!-- ===================== LIVE QTY PANEL ===================== -->
        <!-- Bloc dépendant du registre (NET + GROSS) -->
        <LinearLayout
            android:id="@+id/liveQtyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="12dp"
            android:background="#F2F2F2">

            <!-- NET livré (principal) -->
            <TextView
                android:id="@+id/txtQtyNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVRÉ NET: 0.00"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#000000"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- GROSS livré (secondaire) -->
            <TextView
                android:id="@+id/txtQtyGross"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVRÉ GROSS: 0.00"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#222222"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <!-- ===================== PLACEHOLDER (logs / autres blocs) ===================== -->
        <!-- Le ScrollView principal permet déjà un log scrollable si tu l’ajoutes plus bas -->
        <!-- Rien d’autre n’est ajouté ici volontairement -->

    </LinearLayout>
</ScrollView>