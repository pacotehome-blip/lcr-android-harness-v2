
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:orientation="vertical"
    android:padding="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ligne paramètres -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/edtTo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="To"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtFrom"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="From"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Produit / preset -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/edtProduct"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="Produit"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtPreset"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="Preset L"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Ligne USB -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnScanUsb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USB"/>

        <Spinner
            android:id="@+id/spnUsbDevices"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnPingUsb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ping"/>
    </LinearLayout>

    <!-- Ligne actions -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Copier"/>

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Clear"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Connect"/>
    </LinearLayout>

    <!-- Ligne A/B/C -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="A"/>

        <Button
            android:id="@+id/btnB"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="B"/>

        <Button
            android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="C"/>
    </LinearLayout>

    <!-- Ligne Continue / Terminé -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:enabled="false"
            android:layout_height="wrap_content"
            android:text="Go"/>

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:enabled="false"
            android:layout_height="wrap_content"
            android:text="Stop"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/switchIoLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I/O"/>

    <Button
        android:id="@+id/btnStart"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="(retiré)" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:typeface="monospace"
            android:textSize="11sp"
            android:textColor="#000000"
            android:textIsSelectable="true"/>
    </ScrollView>

</LinearLayout>
