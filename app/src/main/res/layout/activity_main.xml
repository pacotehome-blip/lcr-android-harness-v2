
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- ===================== USB ===================== -->
    <Spinner
        android:id="@+id/spnUsbDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnScanUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan USB" />

        <Button
            android:id="@+id/btnPingUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ouvrir/Ping USB" />
    </LinearLayout>

    <!-- ===================== PARAMÈTRES LCP ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/edtTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="TO (ex: 0xFA)"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="FROM (ex: 0xFF)"
            android:singleLine="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- ===================== PRODUITS (liste 1..16) ===================== -->
    <!-- ✅ Liste fixe fournie par l'UI; le produit actif est sélectionné par défaut via DeliveryController -->
    <Spinner
        android:id="@+id/spnProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <!-- ===================== PRODUIT / PRESET ===================== -->
    <!-- ✅ Produit manuel = override; priorité sur le spinner si rempli -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/edtProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Produit (#) override"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtPreset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Preset"
            android:inputType="numberDecimal"
            android:singleLine="true" />
    </LinearLayout>

    <!-- ===================== CONNEXION LCP ===================== -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect (LCP)"
        android:layout_marginTop="6dp" />

    <!-- ===================== BOUTONS A / B / C + CONTINUER / FINISH ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A" />

        <Button
            android:id="@+id/btnB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="B" />

        <Button
            android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="C" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Continuer" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Terminer" />
    </LinearLayout>

    <!-- ===================== LIVE (ligne unique) ===================== -->
    <TextView
        android:id="@+id/txtLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LIVE: (en attente)"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <!-- ===================== AJOUT MINIMAL : NET / GROSS (big digits) ===================== -->
    <LinearLayout
        android:id="@+id/liveQtyPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:padding="8dp"
        android:background="#F2F2F2">

        <TextView
            android:id="@+id/txtQtyNet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NET: 0.0"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/txtQtyGross"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GROSS: 0.0"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#222222" />
