<?xml version="1.0" encoding="utf-8"?>
<!--
  LCR Android Harness V2 - Écran principal (LinearLayout)
  - Adresses To/From (FA/FF)
  - Product / Preset
  - I/O log (TX/RX)
  - Boutons: Connexion / Diag / Start / Copier / Effacer
  - Console LCP: Scanner, Envoyer HEX, Tester USB
  - Macros A / B / C
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:baselineAligned="false">

    <!-- Ligne To / From -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To (node)"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword"
                android:text="0xFA"
                android:singleLine="true"
                android:hint="ex: 0xFA"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From (host)"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtFrom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword"
                android:text="0xFF"
                android:singleLine="true"
                android:hint="ex: 0xFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Ligne Product / Preset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product #"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:singleLine="true"
                android:hint="ex: 1"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preset"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0"
                android:singleLine="true"
                android:hint="ex: 150.00"/>
        </LinearLayout>
    </LinearLayout>

    <!-- I/O log switch + actions log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <CheckBox
            android:id="@+id/switchIoLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I/O log (TX/RX)"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copier log"/>

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Effacer log"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Ligne commandes principales: Connexion / Diag / Start -->
    <LinearLayout
        android:id="@+id/layoutPrimaryButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Connexion USB"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnDiag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Diag"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Start"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Console LCP : Scanner / Envoyer HEX / Tester USB -->
    <LinearLayout
        android:id="@+id/layoutDiagConsole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Scanner (0x28)"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnSendHex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Envoyer HEX"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/btnTestUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tester port USB"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- DIAGNOSTIQUE LCP : 3 boutons A / B / C -->
    <LinearLayout
        android:id="@+id/layoutDiagABC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="A — Reset (End+Clear)"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="B — Ping(28)+GetMach(23)"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/btnC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="C — Start Delivery"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Zone de log -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:typeface="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@android:color/black"
            android:text="" />
    </ScrollView>

</LinearLayout>