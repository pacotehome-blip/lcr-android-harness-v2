
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apiFaceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtApiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="API-FACE"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtApiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: STOPPED"
        android:textStyle="bold"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/txtApiUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="http://127.0.0.1:8765"
        android:textIsSelectable="true"
        android:paddingTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/btnApiStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start API" />

        <Button
            android:id="@+id/btnApiStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stop API" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtApiHowTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="Workflow API : voir documentation interne / README."
        android:textSize="13sp" />

</LinearLayout>
