
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apiFaceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtApiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="API-FACE"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtApiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: STOPPED"
        android:textStyle="bold"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/txtApiUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="http://127.0.0.1:8765"
        android:textIsSelectable="true"
        android:paddingTop="4dp" />

    <!-- Start/Stop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/btnApiStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start API" />

        <Button
            android:id="@+id/btnApiStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stop API" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtApiHowTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="Workflow attendu:\n1) GET /v1/usb/scan\n2) POST /v1/usb/open-ping\n3) POST /v1/lcp/connect (next=C ou A)\n4a) POST /v1/delivery/oneshot/start (nouveau)\n4b) POST /v1/delivery/C (legacy)\n5) GET /v1/delivery/job/{jobId}\n6) POST /v1/delivery/job/continue (nouveau)\n7) POST /v1/delivery/job/terminate (nouveau)\n\nRègles:\n- Start API refusé si pas de controller (pas de Connect LCP)\n- API locale seulement (127.0.0.1)"
        android:textSize="13sp" />

</LinearLayout>
