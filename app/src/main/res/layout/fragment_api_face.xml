
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apiFaceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtApiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="API-FACE"
        android:textStyle="bold"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/txtApiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: STOPPED"
        android:textStyle="bold"
        android:paddingTop="6dp"/>

    <TextView
        android:id="@+id/txtApiUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="http://127.0.0.1:8765"
        android:textIsSelectable="true"
        android:paddingTop="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/btnApiStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start API"/>

        <Button
            android:id="@+id/btnApiStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stop API"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtApiHowTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="Workflow attendu:\n1) GET /v1/usb/scan\n2) POST /v1/usb/open-ping\n3) POST /v1/lcp/connect (next=C ou A)\n4) POST /v1/register/validate (Registre prêt)\n5a) POST /v1/delivery/oneshot/start (nouveau)\n5b) POST /v1/delivery/C (legacy)\n6) GET /v1/delivery/job/{jobId}\n7) POST /v1/delivery/job/continue (nouveau)\n8) POST /v1/delivery/job/terminate (nouveau)\n\nRègles:\n- API locale seulement (127.0.0.1)\n- Start API possible sans \"Connect LCP\" (headless)\n- /v1/register/validate retourne ticketPending, ticket_no et delivery_uid si numero_livraison fourni"
        android:textSize="13sp"/>
</LinearLayout>
