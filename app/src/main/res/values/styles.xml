
<resources>

    <!-- Bouton standard Filgo Énergie -->
    <style name="FilgoButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Bouton danger (Stop / Terminer) -->
    <style name="FilgoButton.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_danger_bg</item>
        <item name="android:textColor">@color/btn_danger_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Champs texte (si tu utilises encore des EditText simples) -->
    <style name="FilgoEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:padding">10dp</item>
    </style>

</resources>
