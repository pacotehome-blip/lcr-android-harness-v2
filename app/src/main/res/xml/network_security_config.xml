<?xml version="1.0" encoding="utf-8"?>
<!--
  res/xml/network_security_config.xml
  
  - HTTP autorisé uniquement vers 127.0.0.1 et localhost
  - HTTPS avec certificat auto-signé vers votre serveur externe
  - Tout autre trafic HTTP vers l'extérieur reste bloqué
  
  Référencer dans AndroidManifest.xml :
    android:networkSecurityConfig="@xml/network_security_config"
-->
<network-security-config>

    <!-- HTTP autorisé UNIQUEMENT vers l'APK local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- HTTPS avec certificat auto-signé vers votre serveur -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">votre-domaine.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/mon_certificat" />
        </trust-anchors>
    </domain-config>

    <!-- Tout le reste : HTTPS obligatoire + CAs système uniquement -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>