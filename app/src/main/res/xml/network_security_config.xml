<?xml version="1.0" encoding="utf-8"?>
<!--
  res/xml/network_security_config.xml
  
  - HTTP autorisé uniquement vers 127.0.0.1 et localhost
  - HTTPS local : certificat installé dans le store système de la tablette
  - Tout autre trafic HTTP vers l'extérieur reste bloqué
-->
<network-security-config>

    <!-- HTTP autorisé UNIQUEMENT vers le local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Tout le reste : HTTPS obligatoire + CAs système uniquement -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>