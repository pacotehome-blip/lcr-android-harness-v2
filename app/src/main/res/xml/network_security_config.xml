<?xml version="1.0" encoding="utf-8"?>
<!--
  res/xml/network_security_config.xml
  
  Autorise le trafic HTTP (non-HTTPS) uniquement vers 127.0.0.1 et localhost.
  Tout autre trafic HTTP vers l'extérieur reste bloqué — sécurité préservée.
  
  Référencer dans AndroidManifest.xml sur la balise <application> :
    android:networkSecurityConfig="@xml/network_security_config"
-->
<network-security-config>

    <!-- HTTP autorisé UNIQUEMENT vers l'APK local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Tout le reste : HTTPS obligatoire (comportement Android par défaut) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>