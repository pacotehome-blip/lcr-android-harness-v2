
<?xml version="1.0" encoding="utf-8"?>
<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android"
   .hardware.usb.host" android:required="true"/>

    <!-- Permission USB -->
    <uses-permission android:name="android.permission.MANAGE_USB" tools:ignore="ProtectedPermissions"/>

    <application
        android:allowBackup="true"
        android:label="LCR Harness V2"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <activity
            android:name="com.pa.lcrdemo.MainActivity"
            android:exported="true">

            <!-- Main Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Auto-launch when USB device is plugged -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>

            <!-- Link to device_filter.xml -->
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter"/>
        </activity>

        <!-- USB Permission Receiver -->
        <receiver 
            android:name="com.pa.lcrdemo.UsbReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="com.android.example.USB_PERMISSION"/>
            </intent-filter>

        </receiver>

    </application>

</manifest>
