
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />  <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->

    <uses-permission
        android:name="android.permission.MANAGE_USB"
        tools:ignore="ProtectedPermissions" /> <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->

    <!-- API loopback -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->

    <!-- ✅ Bluetooth (Android 9+) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- ✅ Android 12+ (future-proof) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:label="Filgo Registre"
        android:icon="@mipmap/logoenergie1"
        android:roundIcon="@mipmap/logoiconeernergie"
        android:theme="@style/Theme.LcrFilgoEnergie"> <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->

        <activity
            android:name="com.pa.lcrdemo.MainActivity"
            android:exported="true"> <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.pa.lcrdemo.UsbReceiver"
            android:exported="true"> <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->
            <intent-filter>
                <action android:name="com.pa.lcrdemo.USB_PERMISSION" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/usb_device_filter" /> <!-- base existante [2](https://support.senanetworks.com/hc/en-us/sections/205912767-Parani-SD1000-Bluetooth-RS232-Adapter) -->

    </application>

</manifest>
