<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <uses-permission
        android:name="android.permission.MANAGE_USB"
        tools:ignore="ProtectedPermissions" />

    <!-- API loopback -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ✅ Storage legacy (Android 9 / API 28 uniquement) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ✅ Bluetooth (Android 9+) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- ✅ Android 12+ (future-proof) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:required="false" />

    <!-- ✅ Localisation requise pour startDiscovery() -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ✅ Foreground service HTTP -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- ✅ Démarrage automatique au boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ✅ Exclure des optimisations batterie -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:label="Filgo Registre"
        android:icon="@mipmap/logoenergie1"
        android:roundIcon="@mipmap/logoiconeernergie"
        android:theme="@style/Theme.LcrFilgoEnergie"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.pa.lcrdemo.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.microsoft.crm.crmphone.fieldServices"
            android:resizeableActivity="true">
            <!-- Launcher normal -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ✅ Deep Link lcrdemo:// — appelé depuis Field Service Mobile -->
            <intent-filter android:label="LCR Deep Link">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lcrdemo" />
            </intent-filter>
        </activity>

        <!-- ✅ FieldService container WebView -->
        <activity
            android:name="com.pa.lcrdemo.FieldServiceActivity"
            android:label="Field Service"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- ✅ MSAL — BrowserTabActivity pour le flow OAuth interactif -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="com.pa.lcrdemo"
                    android:path="/5ut2u98D3lhweiDQ6Y3bDp7tREw=" />
            </intent-filter>
        </activity>

        <!-- ✅ Foreground service — maintient le serveur HTTP :8765/:8766 actif -->
        <service
            android:name="com.pa.lcrdemo.LcrHttpService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- ✅ Boot receiver — démarre LcrHttpService au boot -->
        <receiver
            android:name="com.pa.lcrdemo.LcrBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.pa.lcrdemo.UsbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pa.lcrdemo.USB_PERMISSION" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/usb_device_filter" />

    </application>
</manifest>
