
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB Host -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" /> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->

    <!-- (Optionnel / protégé) : conservé tel quel, comme dans ton fichier -->
    <uses-permission
        android:name="android.permission.MANAGE_USB"
        tools:ignore="ProtectedPermissions" /> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->

    <!-- ✅ Nécessaire pour ServerSocket (API locale 127.0.0.1:8765) -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->

    <!-- ✅ BLUETOOTH (Android 9 et +) : requis pour lire les appareils appairés -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- ✅ Android 12+ (future-proof). Runtime demandé par ton code si SDK>=S -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:label="Filgo Registre"
        android:icon="@mipmap/logoenergie1"
        android:roundIcon="@mipmap/logoiconeernergie"
        android:theme="@style/Theme.LcrFilgoEnergie"> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->

        <activity
            android:name="com.pa.lcrdemo.MainActivity"
            android:exported="true"> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.pa.lcrdemo.UsbReceiver"
            android:exported="true"> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->
            <intent-filter>
                <action android:name="com.pa.lcrdemo.USB_PERMISSION" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/usb_device_filter" /> <!-- [1](https://groupefilgo-my.sharepoint.com/personal/paul-andre_cote_filgo_ca/Documents/Fichiers%20Microsoft%20Copilot%20Chat/MainActivity.java) -->

    </application>

</manifest>
